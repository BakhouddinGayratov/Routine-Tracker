# Copy to .env and adjust. Every value has a safe default for local development.

# HTTP port the server listens on
PORT=3000

# Secret used to sign JSON Web Tokens.
# Leave empty in development: a random secret is generated and cached in data/.jwt-secret
# In production ALWAYS set this to a long random string (e.g. `openssl rand -hex 48`).
JWT_SECRET=

# How long an access token stays valid
JWT_EXPIRES_IN=30d

# Absolute or relative path of the SQLite database file
DATABASE_PATH=./data/routine-tracker.sqlite

# Which SQLite driver to use.
#   auto            (default) prefer Node's built-in node:sqlite, fall back to better-sqlite3
#   node            force the built-in (needs Node 22.13+)
#   better-sqlite3  force the native module (install it yourself: npm i better-sqlite3)
DATABASE_DRIVER=auto

# "production" enables secure cookies and disables verbose errors
NODE_ENV=development

# Comma separated list of allowed origins for cross-origin API access.
# Empty means "same origin only", which is what you want when the SPA is
# served by this very server.
CORS_ORIGINS=

# Daily database backups: one consistent copy per day in BACKUP_DIR, keeping
# the newest BACKUP_KEEP. Set BACKUPS=off to disable. `npm run backup` takes
# one on demand. (Always off under NODE_ENV=test.)
BACKUPS=on
BACKUP_DIR=./data/backups
BACKUP_KEEP=7
